rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Unified User Profile Collection
    match /users/{userId} {
      // Users can read/write their own profile.
      // Owners and Admins can manage their own team (ownerId check).
      
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['superadmin', 'super_admin'] ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId
      );
      
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['superadmin', 'super_admin'] ||
        // Check if target ownerId matches creator's UID (Owner) or creator's own ownerId (Admin)
        (request.method == 'create' && (
          request.resource.data.ownerId == request.auth.uid ||
          request.resource.data.ownerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId
        )) ||
        (exists(/databases/$(database)/documents/users/$(userId)) && (
          get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(userId)).data.ownerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId
        ))
      );
    }

    // 2. Multi-Tenant Business Data (Scoped by ownerId)
    match /owners/{ownerId}/{subcollection}/{docId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == ownerId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId == ownerId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['superadmin', 'super_admin']
      );
    }

    // 3. Registration System
    match /registration_requests/{requestId} {
      allow create: if true;
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['superadmin', 'super_admin'];
    }

    // 4. Global Admin Access (Safety catch-all)
    match /{document=**} {
      allow read, write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['superadmin', 'super_admin']
      );
    }
  }
}
